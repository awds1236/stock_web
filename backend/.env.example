# ── 한국 (KRX) ──────────────────────────────────────────────────────────
# KRX Open API 인증키 -- https://openapi.krx.co.kr 에서 발급
# 주의: 인증키 발급과 '서비스별 이용신청'은 별개입니다. 키만 받고 이용신청을
# 안 하면 엔드포인트가 존재해도 접근할 수 없습니다.
# 일일 호출 한도 10,000회.
KRX_AUTH_KEY=

# ── 미국 (SEC EDGAR) ────────────────────────────────────────────────────
# SEC 는 User-Agent 에 실제 연락처를 요구합니다. 없거나 형식이 맞지 않으면
# 요청이 차단됩니다. 초당 10회 이하로 제한됩니다.
SEC_USER_AGENT=Your Name your@email.com

# ── AI 분석 (선택) ──────────────────────────────────────────────────────
# AI 서술 분석에만 쓰입니다. 없어도 시세·지표·예측은 전부 동작합니다.
# 보통은 이 파일 대신 앱의 설정 화면에서 입력하십시오 -- 그러면 암호화되어
# 저장소 바깥에 보관됩니다. 여기(또는 배포 환경변수)에 넣으면 그쪽이 우선합니다.
OPENAI_API_KEY=

# 모델 이름과 엔드포인트. 설정 화면에서도 바꿀 수 있으며, 여기에 값이 있으면
# 환경변수가 이깁니다. 앱은 모델 이름을 검증하지 않고 그대로 전달합니다.
# AI_MODEL=gpt-5.6-luna
# AI_BASE_URL=https://api.openai.com/v1

# ── 주가 자동 갱신 (선택) ───────────────────────────────────────────────
# 설정 화면에서 켜는 것이 기본이며, 여기 값이 있으면 환경변수가 이깁니다.
# AUTO_REFRESH_ENABLED=false
# AUTO_REFRESH_INTERVAL_MINUTES=60

# ── 거래비용 (전부 소수 비율: 0.0015 == 0.15%) ──────────────────────────
# 시장별 접두사가 필요합니다. 한국 거래세(0.15%)와 미국 SEC 수수료(0.00278%)는
# 자릿수가 다르므로, 공용 변수를 두면 한쪽에 맞춘 값이 다른 쪽에 조용히
# 적용됩니다.
#
# 아래 값은 전부 자리표시자이며 실제 세율이 아닙니다.
# 백테스트를 돌리기 전에 현행 요율을 확인해 넣으십시오.
# 사용된 값은 모든 백테스트 리포트에 함께 기록됩니다.

# 한국: 매도 시 증권거래세 + 농어촌특별세. 시장·연도에 따라 다르며 최근
# 수년간 반복적으로 변경되었습니다.
COST_KR_SELL_TAX=0.0015
COST_KR_COMMISSION=0.00015
COST_KR_SLIPPAGE=0.001
COST_KR_MAX_PARTICIPATION=0.01

# 미국: 증권거래세 없음. 매도 시 SEC Section 31 수수료 + FINRA TAF 만 부과되며
# 요율은 매년 조정됩니다. 주요 리테일 브로커 수수료는 0.
COST_US_SELL_TAX=0.0000278
COST_US_COMMISSION=0.0
COST_US_SLIPPAGE=0.0005
COST_US_MAX_PARTICIPATION=0.01
